---
import Layout from '../../layouts/Layout.astro';
import ServiceAreaMap from '../../components/ServiceAreaMap.astro';
---

<Layout
  title="Zones d'Intervention Plombier Tournai | Kain, Froyennes, Templeuve & Grand Tournai"
  description="Dépannage plomberie d'urgence en 30 min dans toutes les communes du Grand Tournai : Tournai centre (7500), Kain (7540), Froyennes (7503), Templeuve (7520), Gaurain. Service 24/7."
  canonicalPath="/locations"
  currentPage="locations"
>
  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <div class="badge-pill">
        <span>Maillage Territorial Hainaut Occidental</span>
      </div>
      <h1 class="page-title">Zones d'Intervention de Plombier Tournai</h1>
      <p class="page-subtitle">
        Basés au coeur de Tournai, nos véhicules d'intervention sillonnent quotidiennement l'ensemble des 29 entités fusionnées pour un dépannage express en moins de 30 minutes.
      </p>
    </div>
  </section>

  <!-- Interactive Search / Filter Widget -->
  <section class="section search-section">
    <div class="container">
      <div class="search-widget-card">
        <div class="search-header">
          <h3>Vérifiez la Disponibilité dans Votre Commune</h3>
          <p>Tapez votre code postal ou le nom de votre village pour connaître le délai de route immédiat.</p>
        </div>
        <div class="search-bar">
          <input
            type="text"
            id="communeSearch"
            placeholder="Ex: 7540, Kain, Froyennes, Templeuve..."
            class="form-input search-input"
          />
          <button class="btn-primary" id="searchBtn" type="button">
            <span>Vérifier</span>
          </button>
        </div>
        <div class="search-tags">
          <span class="tag-label">Communes fréquentes :</span>
          <button class="filter-pill active" data-filter="all">Toutes</button>
          <button class="filter-pill" data-filter="7500">Tournai (7500)</button>
          <button class="filter-pill" data-filter="7540">Kain (7540)</button>
          <button class="filter-pill" data-filter="7503">Froyennes (7503)</button>
          <button class="filter-pill" data-filter="7520">Templeuve (7520)</button>
          <button class="filter-pill" data-filter="7530">Gaurain (7530)</button>
          <button class="filter-pill" data-filter="7522">Blandain (7522)</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Grid of Main Location Hubs -->
  <section class="section">
    <div class="container">
      <div class="section-title-wrap">
        <div class="badge-pill">
          <span>Délais Garantis</span>
        </div>
        <h2>Nos Pôles d'Intervention Prioritaires</h2>
        <p>Une présence renforcée sur les axes stratégiques du Tournaisis pour sécuriser vos installations sanitaires.</p>
      </div>

      <div class="grid-3 locations-grid" id="locationsGrid">
        <!-- Location 1 -->
        <div class="card location-card" data-code="7500" data-name="tournai centre saint-piat saint-brice marvis">
          <div class="location-header">
            <div>
              <span class="postal-badge">7500</span>
              <h3 class="location-name">Tournai Centre</h3>
            </div>
            <span class="eta-tag">Délai : 15-20 min</span>
          </div>
          <p class="location-desc">
            Maisons de maître, immeubles à appartements et centre historique. Nous intervenons fréquemment pour la détection acoustique de fuite sans démolition et la réfection de tuyauteries anciennes en plomb.
          </p>
          <ul class="location-services">
            <li>Recherche de fuite non destructive</li>
            <li>Débouchage WC & colonnes d'évacuation</li>
            <li>Remplacement robinet d'arrêt avant compteur</li>
          </ul>
          <a href="tel:+3269456070" class="btn-outline location-btn">Appeler à Tournai Centre</a>
        </div>

        <!-- Location 2 -->
        <div class="card location-card" data-code="7540" data-name="kain trinite mont">
          <div class="location-header">
            <div>
              <span class="postal-badge">7540</span>
              <h3 class="location-name">Kain</h3>
            </div>
            <span class="eta-tag">Délai : 20-25 min</span>
          </div>
          <p class="location-desc">
            Du bas de Kain jusqu'au Mont de la Trinité. Secteur pavillonnaire soumis à une eau particulièrement calcaire (SWDE). Spécialiste de la pose d'adoucisseurs et du détartrage de boilers électriques.
          </p>
          <ul class="location-services">
            <li>Détartrage & remplacement de boiler</li>
            <li>Installation d'adoucisseur anti-calcaire</li>
            <li>Dépannage fuite après compteur d'eau</li>
          </ul>
          <div class="location-actions">
            <a href="tel:+3269456070" class="btn-primary location-btn">069 45 60 70</a>
            <a href="/locations/kain" class="btn-outline location-btn">Page dédiée Kain</a>
          </div>
        </div>

        <!-- Location 3 -->
        <div class="card location-card" data-code="7503" data-name="froyennes zone commerciale">
          <div class="location-header">
            <div>
              <span class="postal-badge">7503</span>
              <h3 class="location-name">Froyennes</h3>
            </div>
            <span class="eta-tag">Délai : 15-25 min</span>
          </div>
          <p class="location-desc">
            Intervention rapide aux abords de l'autoroute E42 et de la zone commerciale. Dépannage urgent pour particuliers et commerces : siphons de sol, éviers bouchés et réducteurs de pression.
          </p>
          <ul class="location-services">
            <li>Hydrocurage haute pression des égouts</li>
            <li>Débouchage express bacs à graisse</li>
            <li>Réparation fuite sous évier et robinetterie</li>
          </ul>
          <div class="location-actions">
            <a href="tel:+3269456070" class="btn-primary location-btn">069 45 60 70</a>
            <a href="/locations/froyennes" class="btn-outline location-btn">Page dédiée Froyennes</a>
          </div>
        </div>

        <!-- Location 4 -->
        <div class="card location-card" data-code="7520" data-name="templeuve ramegnies-chin">
          <div class="location-header">
            <div>
              <span class="postal-badge">7520</span>
              <h3 class="location-name">Templeuve</h3>
            </div>
            <span class="eta-tag">Délai : 20-30 min</span>
          </div>
          <p class="location-desc">
            Grandes habitations et lotissements récents. Nos techniciens assurent la maintenance des pompes de relevage, le curage de fosses septiques et la mise en conformité des conduites d'eau sanitaire.
          </p>
          <ul class="location-services">
            <li>Débouchage canalisations extérieures</li>
            <li>Inspection vidéo caméra étanche HD</li>
            <li>Pose de WC suspendus Geberit</li>
          </ul>
          <div class="location-actions">
            <a href="tel:+3269456070" class="btn-primary location-btn">069 45 60 70</a>
            <a href="/locations/templeuve" class="btn-outline location-btn">Page dédiée Templeuve</a>
          </div>
        </div>

        <!-- Location 5 -->
        <div class="card location-card" data-code="7522" data-name="blandain frontiere">
          <div class="location-header">
            <div>
              <span class="postal-badge">7522</span>
              <h3 class="location-name">Blandain</h3>
            </div>
            <span class="eta-tag">Délai : 20-30 min</span>
          </div>
          <p class="location-desc">
            À la frontière franco-belge, habitations traditionnelles en briques rouges. Travaux de modernisation de plomberie : remplacement des vieux tuyaux en fonte et cuivre par du multicouche garanti 10 ans.
          </p>
          <ul class="location-services">
            <li>Rénovation tuyauterie multicouche serti</li>
            <li>Réparation chasse d'eau et robinets fuyards</li>
            <li>Rapport technique pour sinistre dégât des eaux</li>
          </ul>
          <div class="location-actions">
            <a href="tel:+3269456070" class="btn-primary location-btn">069 45 60 70</a>
            <a href="/locations/blandain" class="btn-outline location-btn">Page dédiée Blandain</a>
          </div>
        </div>

        <!-- Location 6 -->
        <div class="card location-card" data-code="7530" data-name="gaurain-ramecroix gaurain ramecroix">
          <div class="location-header">
            <div>
              <span class="postal-badge">7530</span>
              <h3 class="location-name">Gaurain-Ramecroix</h3>
            </div>
            <span class="eta-tag">Délai : 25-30 min</span>
          </div>
          <p class="location-desc">
            Bassin carrier et habitations rurales. Nous intervenons sur les réseaux d'eau sous forte pression avec pose de régulateurs et clapets anti-pollution Belgaqua agréés par la SWDE.
          </p>
          <ul class="location-services">
            <li>Mise en conformité compteur SWDE</li>
            <li>Remplacement de boiler 150L à 200L</li>
            <li>Élimination des bruits de coup de bélier</li>
          </ul>
          <div class="location-actions">
            <a href="tel:+3269456070" class="btn-primary location-btn">069 45 60 70</a>
            <a href="/locations/gaurain-ramecroix" class="btn-outline location-btn">Page dédiée Gaurain</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Complete list of all 29 entities of Tournai -->
  <section class="section bg-light-section">
    <div class="container">
      <div class="section-title-wrap">
        <div class="badge-pill">
          <span>Couverture Intégrale</span>
        </div>
        <h2>Toutes les Entités & Villages Desservis</h2>
        <p>Même dans les zones rurales les plus reculées, notre service d'astreinte 24h/24 se déplace sans surcoût de distance abusif.</p>
      </div>

      <div class="all-entities-grid">
        <div class="entity-item"><strong>Barry</strong> <span>(7534)</span></div>
        <div class="entity-item"><strong>Béclers</strong> <span>(7532)</span></div>
        <div class="entity-item"><strong>Blandain</strong> <span>(7522)</span></div>
        <div class="entity-item"><strong>Chercq</strong> <span>(7521)</span></div>
        <div class="entity-item"><strong>Ere</strong> <span>(7500)</span></div>
        <div class="entity-item"><strong>Esplechin</strong> <span>(7502)</span></div>
        <div class="entity-item"><strong>Froidmont</strong> <span>(7504)</span></div>
        <div class="entity-item"><strong>Froyennes</strong> <span>(7503)</span></div>
        <div class="entity-item"><strong>Gaurain-Ramecroix</strong> <span>(7530)</span></div>
        <div class="entity-item"><strong>Havinnes</strong> <span>(7531)</span></div>
        <div class="entity-item"><strong>Hertain</strong> <span>(7522)</span></div>
        <div class="entity-item"><strong>Kain</strong> <span>(7540)</span></div>
        <div class="entity-item"><strong>Lamain</strong> <span>(7522)</span></div>
        <div class="entity-item"><strong>Marquain</strong> <span>(7522)</span></div>
        <div class="entity-item"><strong>Maulde</strong> <span>(7534)</span></div>
        <div class="entity-item"><strong>Melles</strong> <span>(7540)</span></div>
        <div class="entity-item"><strong>Mont-Saint-Aubert</strong> <span>(7542)</span></div>
        <div class="entity-item"><strong>Mourcourt</strong> <span>(7543)</span></div>
        <div class="entity-item"><strong>Orcq</strong> <span>(7501)</span></div>
        <div class="entity-item"><strong>Quartes</strong> <span>(7540)</span></div>
        <div class="entity-item"><strong>Ramegnies-Chin</strong> <span>(7520)</span></div>
        <div class="entity-item"><strong>Rumillies</strong> <span>(7540)</span></div>
        <div class="entity-item"><strong>Saint-Maur</strong> <span>(7500)</span></div>
        <div class="entity-item"><strong>Templeuve</strong> <span>(7520)</span></div>
        <div class="entity-item"><strong>Thimougies</strong> <span>(7533)</span></div>
        <div class="entity-item"><strong>Tournai Centre</strong> <span>(7500)</span></div>
        <div class="entity-item"><strong>Vaulx</strong> <span>(7521)</span></div>
        <div class="entity-item"><strong>Vezon</strong> <span>(7538)</span></div>
        <div class="entity-item"><strong>Warchin</strong> <span>(7548)</span></div>
        <div class="entity-item"><strong>Willemeau</strong> <span>(7506)</span></div>
      </div>
    </div>
  </section>

  <!-- Service Area Map Section -->
  <ServiceAreaMap />

  <!-- Emergency Dispatch Action -->
  <section class="section">
    <div class="container">
      <div class="card dispatch-cta-card">
        <div class="dispatch-content">
          <div class="badge-pill">
            <span class="badge-dot"></span>
            <span>Permanence Locale</span>
          </div>
          <h2>Votre Commune N'attend Pas : Intervention Rapide</h2>
          <p>
            Vous résidez dans le Tournaisis et faites face à une fuite d'eau abondante ou un débordement d'égout ? Composez directement notre numéro d'urgence pour mobiliser l'artisan le plus proche de votre adresse.
          </p>
          <div class="dispatch-actions">
            <a href="tel:+3269456070" class="btn-primary">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>Appeler le 069 45 60 70</span>
            </a>
            <a href="/contact" class="btn-outline">Formulaire de contact</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const searchInput = document.getElementById('communeSearch') as HTMLInputElement | null;
  const filterPills = document.querySelectorAll('.filter-pill');
  const cards = document.querySelectorAll('.location-card');

  function filterLocations(query: string) {
    const q = query.toLowerCase().trim();
    cards.forEach((card) => {
      const code = card.getAttribute('data-code') || '';
      const name = card.getAttribute('data-name') || '';
      if (q === '' || q === 'all' || code.includes(q) || name.includes(q)) {
        (card as HTMLElement).style.display = 'flex';
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });
  }

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value;
      filterLocations(val);
      filterPills.forEach(p => p.classList.remove('active'));
    });
  }

  filterPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      filterPills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      const filter = pill.getAttribute('data-filter') || 'all';
      if (searchInput) searchInput.value = '';
      filterLocations(filter === 'all' ? '' : filter);
    });
  });
</script>

<style>
  .page-header {
    background: linear-gradient(180deg, var(--color-surface) 0%, var(--color-surface-container-low) 100%);
    padding: 56px 0 36px;
    text-align: center;
  }

  .page-title {
    font-size: 36px;
    letter-spacing: -0.02em;
    margin-top: 14px;
    margin-bottom: 12px;
  }

  @media (min-width: 768px) {
    .page-title {
      font-size: 46px;
    }
  }

  .page-subtitle {
    font-size: 17px;
    max-width: 680px;
    margin: 0 auto;
    color: var(--color-on-surface-variant);
  }

  /* Search Widget */
  .search-section {
    padding-top: 24px;
    padding-bottom: 40px;
  }

  .search-widget-card {
    background-color: var(--color-surface-container-lowest);
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--radius-xl);
    padding: 36px;
    box-shadow: var(--shadow-card);
    max-width: 860px;
    margin: 0 auto;
    text-align: center;
  }

  .search-header h3 {
    font-size: 22px;
    margin-bottom: 8px;
  }

  .search-header p {
    font-size: 14px;
    margin-bottom: 24px;
  }

  .search-bar {
    display: flex;
    gap: 12px;
    max-width: 540px;
    margin: 0 auto 20px;
  }

  .search-input {
    flex-grow: 1;
  }

  .search-tags {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 13px;
  }

  .tag-label {
    color: var(--color-outline);
    font-weight: 600;
  }

  .filter-pill {
    background: var(--color-surface-container-low);
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--radius-full);
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-on-surface);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-pill:hover, .filter-pill.active {
    background-color: var(--color-primary-container);
    color: #ffffff;
    border-color: var(--color-primary-container);
  }

  /* Location Card */
  .location-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 28px;
  }

  .location-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }

  .postal-badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 800;
    color: var(--color-primary-container);
    background-color: var(--color-primary-fixed);
    padding: 2px 8px;
    border-radius: 4px;
    margin-bottom: 4px;
  }

  .location-name {
    font-size: 22px;
    margin-top: 2px;
  }

  .eta-tag {
    font-size: 12px;
    font-weight: 700;
    color: var(--color-on-tertiary-fixed);
    background-color: var(--color-secondary-container);
    padding: 4px 10px;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .location-desc {
    font-size: 14px;
    line-height: 1.6;
    margin-bottom: 18px;
  }

  .location-services {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 13px;
    margin-bottom: 24px;
    margin-top: auto;
    padding-left: 0;
  }

  .location-services li {
    position: relative;
    padding-left: 18px;
  }

  .location-services li::before {
    content: '-';
    position: absolute;
    left: 0;
    color: var(--color-primary-container);
    font-weight: bold;
  }

  .location-actions {
    display: flex;
    gap: 8px;
    width: 100%;
  }

  .location-actions .location-btn {
    flex: 1;
    text-align: center;
    padding: 10px 8px;
    font-size: 13px;
    white-space: nowrap;
  }

  /* All entities grid */
  .bg-light-section {
    background-color: var(--color-surface-container-low);
  }

  .all-entities-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  @media (min-width: 640px) {
    .all-entities-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .all-entities-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .entity-item {
    background-color: #ffffff;
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
    font-size: 13px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .entity-item strong {
    color: var(--color-on-surface);
  }

  .entity-item span {
    color: var(--color-outline);
    font-size: 12px;
  }

  /* Dispatch CTA */
  .dispatch-cta-card {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-on-tertiary-fixed) 100%);
    color: #ffffff;
    padding: 48px 36px;
    text-align: center;
  }

  .dispatch-content {
    max-width: 720px;
    margin: 0 auto;
  }

  .dispatch-content h2 {
    color: #ffffff;
    font-size: 32px;
    margin-top: 14px;
    margin-bottom: 14px;
  }

  .dispatch-content p {
    color: var(--color-surface-dim);
    font-size: 16px;
    margin-bottom: 28px;
  }

  .dispatch-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    justify-content: center;
    align-items: center;
  }

  @media (min-width: 640px) {
    .dispatch-actions {
      flex-direction: row;
    }
  }
</style>
