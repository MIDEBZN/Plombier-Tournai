---
import Layout from '../layouts/Layout.astro';
import ReviewBadges from '../components/ReviewBadges.astro';
import ResponseTimeStats from '../components/ResponseTimeStats.astro';
import TrustBadges from '../components/TrustBadges.astro';
import ServiceAreaMap from '../components/ServiceAreaMap.astro';
import CustomerTestimonials from '../components/CustomerTestimonials.astro';
---

<Layout
  title="Plombier Tournai Agréé | Dépannage 24/7 en 30 Min & Devis Gratuit"
  description="Artisan plombier agréé à Tournai (7500). Dépannage d'urgence 24h/24 en 30 min : fuite d'eau, débouchage canalisation, réparation boiler. Agréé assurances belges. Devis 100% gratuit."
  canonicalPath="/"
  currentPage="home"
  preloadImage="/images/hero-real-sink.webp"
>
  <!-- 1. HERO SECTION -->
  <section class="hero-section">
    <div class="container hero-inner">
      <div class="hero-content">
        <div class="badge-pill">
          <span class="badge-dot"></span>
          <span>Artisan Plombier Agréé à Tournai & Périphérie</span>
        </div>

        <h1 class="hero-title">
          Plombier à Tournai : <span class="highlight-text">Dépannage Rapide 24/7, Débouchage & Sanitaire</span>
        </h1>

        <p class="hero-description">
          Une fuite d'eau sous évier, une canalisation bouchée ou un boiler en panne ? Nos artisans qualifiés interviennent en 30 minutes dans le Grand Tournai. Devis clair et validé avant le début des travaux, sans aucun frais caché.
        </p>

        <!-- CTAs -->
        <div class="hero-ctas">
          <a href="tel:0464780573" class="btn-primary hero-btn-call">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>Appeler le 0464 78 05 73</span>
          </a>
          <a href="/contact" class="btn-outline hero-btn-devis">
            <span>Demander un devis gratuit</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <!-- Reassurance list -->
        <div class="hero-features">
          <div class="feature-item">
            <span class="feature-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </span>
            <span>Arrivée en 30 minutes chrono</span>
          </div>
          <div class="feature-item">
            <span class="feature-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </span>
            <span>Devis transparent avant travaux</span>
          </div>
          <div class="feature-item">
            <span class="feature-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </span>
            <span>Agréé assurances belges</span>
          </div>
        </div>
      </div>

      <!-- Hero Visual -->
      <div class="hero-visual">
        <div class="hero-image-wrapper">
          <img
            src="/images/hero-real-sink.webp"
            alt="Artisan plombier intervenant sur une canalisation d'évacuation sous évier à Tournai"
            width="600"
            height="500"
            class="hero-img"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="hero-floating-card">
            <div class="floating-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
              </svg>
            </div>
            <div class="floating-text">
              <strong>Urgence fuite ou boiler en panne ?</strong>
              <span>Service de garde disponible 7j/7 - Réponse immédiate</span>
            </div>
            <a href="tel:+3269456070" class="floating-btn" aria-label="Appeler d'urgence">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Review Badges (Google 4.9/5, Trustpilot 4.8/5, Bati-Avis, Pages d'Or) -->
  <ReviewBadges />

  <!-- Response Time Stats (30 min, 98.4%, 4850+ interventions, 15 ans) -->
  <ResponseTimeStats />

  <!-- 2. REASSURANCE STRIP -->
  <section class="strip-section">
    <div class="container strip-grid">
      <div class="strip-card">
        <div class="strip-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
        </div>
        <div>
          <h3 class="strip-title">Intervention Locale Rapide</h3>
          <p class="strip-desc">Tournai, Kain, Froyennes, Templeuve, Blandain</p>
        </div>
      </div>

      <div class="strip-card">
        <div class="strip-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
        </div>
        <div>
          <h3 class="strip-title">Devis 100% Transparent</h3>
          <p class="strip-desc">Tarif annoncé avant toute intervention</p>
        </div>
      </div>

      <div class="strip-card">
        <div class="strip-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <div>
          <h3 class="strip-title">Rapports Assurance Agréés</h3>
          <p class="strip-desc">Prise en charge intégrale dégât des eaux</p>
        </div>
      </div>

      <div class="strip-card">
        <div class="strip-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 14 14"></polyline>
          </svg>
        </div>
        <div>
          <h3 class="strip-title">Astreinte 24h/24 & 7j/7</h3>
          <p class="strip-desc">Nuit, week-ends et jours fériés inclus</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. SERVICES GRID -->
  <section class="section">
    <div class="container">
      <div class="section-title-wrap">
        <div class="badge-pill">
          <span>Expertises & Dépannages</span>
        </div>
        <h2>Nos Services de Plomberie dans le Tournaisis</h2>
        <p>
          Du dépannage express en 30 minutes aux travaux d'installation sanitaire complète, nous intervenons avec un outillage de pointe pour préserver votre habitat.
        </p>
      </div>

      <div class="grid-3">
        <!-- Service 1 -->
        <div class="card service-card">
          <div class="icon-box">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
            </svg>
          </div>
          <h3 class="service-title">Recherche de Fuite Non Destructive</h3>
          <p class="service-desc">
            Localisation précise sans casser vos carrelages ni cloisons grâce à nos caméras thermiques Flir, gaz traceur et capteurs acoustiques. Rédaction du rapport officiel sous 24h pour remboursement assurance (AXA, Ethias, Belfius).
          </p>
          <ul class="service-list">
            <li>Fuite invisible après compteur SWDE</li>
            <li>Infiltration sous chape ou plancher chauffant</li>
            <li>Rapport d'expertise certifié pour sinistre</li>
          </ul>
          <a href="/services#recherche-fuite" class="service-link">
            <span>En savoir plus sur la détection de fuite</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>

        <!-- Service 2 -->
        <div class="card service-card">
          <div class="icon-box">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
            </svg>
          </div>
          <h3 class="service-title">Débouchage & Inspection Caméra Vidéo</h3>
          <p class="service-desc">
            Débouchage mécanique au furet électrique ou hydrocurage haute pression pour WC obstrués, colonnes générales, éviers et canalisations extérieures. Contrôle vidéo immédiat sur écran HD.
          </p>
          <ul class="service-list">
            <li>WC bouché et débordement d'urgence</li>
            <li>Hydrocurage haute pression 180 bars</li>
            <li>Inspection caméra couleur avec enregistrement</li>
          </ul>
          <a href="/services#debouchage" class="service-link">
            <span>En savoir plus sur le débouchage</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>

        <!-- Service 3 -->
        <div class="card service-card">
          <div class="icon-box">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="4" y="2" width="16" height="20" rx="2"></rect>
              <line x1="8" y1="6" x2="16" y2="6"></line>
              <line x1="16" y1="14" x2="16" y2="18"></line>
            </svg>
          </div>
          <h3 class="service-title">Dépannage & Remplacement de Boiler</h3>
          <p class="service-desc">
            Panne d'eau chaude, cuve percée ou boiler qui disjoncte ? Dépannage rapide de résistance stéatite, thermostat et groupe de sécurité. Remplacement express de chauffe-eau électrique ou thermodynamique.
          </p>
          <ul class="service-list">
            <li>Détartrage complet de la cuve et de l'anode</li>
            <li>Remplacement du groupe de sécurité qui fuit</li>
            <li>Fourniture et pose de boiler neuf en 24h</li>
          </ul>
          <a href="/services#boiler" class="service-link">
            <span>En savoir plus sur les boilers</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>

        <!-- Service 4 -->
        <div class="card service-card">
          <div class="icon-box">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2v20"></path>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <h3 class="service-title">Traitement du Calcaire & Adoucisseurs</h3>
          <p class="service-desc">
            Dans le Tournaisis, la dureté de l'eau SWDE atteint 35 à 45 degrés français. Nous installons des adoucisseurs d'eau compacts à résine haute performance pour protéger vos canalisations, robinetteries et appareils électroménagers.
          </p>
          <ul class="service-list">
            <li>Baisse drastique de votre facture d'énergie</li>
            <li>Élimination totale des traces de tartre</li>
            <li>Entretien annuel et livraison de sel</li>
          </ul>
          <a href="/services#adoucisseur" class="service-link">
            <span>En savoir plus sur les adoucisseurs</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>

        <!-- Service 5 -->
        <div class="card service-card">
          <div class="icon-box">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
          </div>
          <h3 class="service-title">Rénovation Sanitaire & WC Geberit</h3>
          <p class="service-desc">
            Modernisation de vos installations d'eau : remplacement de tuyauteries vétustes en plomb ou cuivre par du multicouche serti, pose de WC suspendus Geberit et robinetterie mitigeuse thermostatique.
          </p>
          <ul class="service-list">
            <li>Chasse d'eau qui coule ou mécanisme entartré</li>
            <li>Rénovation complète d'arrivée et d'évacuation</li>
            <li>Installation de douches à l'italienne étanches</li>
          </ul>
          <a href="/services#sanitaire" class="service-link">
            <span>En savoir plus sur le sanitaire</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>

        <!-- Service 6 -->
        <div class="card service-card">
          <div class="icon-box">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
            </svg>
          </div>
          <h3 class="service-title">Mise en Conformité & Réseau SWDE</h3>
          <p class="service-desc">
            Raccordement au réseau public, remplacement de robinet d'arrêt général avant/après compteur d'eau, installation de clapets anti-retour agréés Belgaqua et réducteurs de pression normalisés.
          </p>
          <ul class="service-list">
            <li>Mise en conformité suite à contrôle SWDE</li>
            <li>Élimination des coups de bélier dans les tuyaux</li>
            <li>Robinetterie d'arrêt sécurisée 1/4 de tour</li>
          </ul>
          <a href="/services#swde" class="service-link">
            <span>En savoir plus sur la conformité</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. COMPETITOR COMPARISON TABLE -->
  <section class="section compare-section">
    <div class="container">
      <div class="section-title-wrap">
        <div class="badge-pill">
          <span>La Différence Artisanale</span>
        </div>
        <h2>Pourquoi Choisir Plombier Tournai ?</h2>
        <p>
          Face aux plateformes d'intermédiation parisiennes ou bruxelloises et aux centrales d'appel opaques, voici notre engagement de proximité réelle dans le Hainaut.
        </p>
      </div>

      <div class="compare-card">
        <div class="table-responsive">
          <table class="compare-table">
            <thead>
              <tr>
                <th>Critère de Qualité</th>
                <th class="col-highlight">Plombier Tournai (Notre Équipe)</th>
                <th>Plateformes & Centrales Nationales</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Délai d'intervention</strong></td>
                <td class="col-highlight text-success"><strong>30 minutes réelles dans le Grand Tournai</strong></td>
                <td>1h30 à 3 heures (sous-traitants lointains)</td>
              </tr>
              <tr>
                <td><strong>Transparence tarifaire</strong></td>
                <td class="col-highlight text-success"><strong>Devis écrit et chiffré avant tout geste technique</strong></td>
                <td>Prix flou au téléphone, suppléments surprises</td>
              </tr>
              <tr>
                <td><strong>Prise en charge assurances</strong></td>
                <td class="col-highlight text-success"><strong>Rapports d'expertise agréés (AXA, Ethias, Belfius)</strong></td>
                <td>Simple facture sans détails techniques</td>
              </tr>
              <tr>
                <td><strong>Ancrage & atelier local</strong></td>
                <td class="col-highlight text-success"><strong>Artisans basés à Tournai, pièces en stock camionnette</strong></td>
                <td>Boîte postale virtuelle, pas de SAV local</td>
              </tr>
              <tr>
                <td><strong>Matériel de diagnostic</strong></td>
                <td class="col-highlight text-success"><strong>Caméra thermique, gaz traceur, hydrocureur HD</strong></td>
                <td>Outils basiques, casse fréquente de carrelage</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Badges & Regulatory Labels (Cerga, Belgaqua, VCA, Garantie Décennale 10 Ans, G1/G2, Assurances) -->
  <TrustBadges />

  <!-- Service Area Map (Grand Tournai & 29 Entités, Visual SVG Map & Commune Selector) -->
  <ServiceAreaMap />

  <!-- Customer Testimonials (Verified Reviews & Aggregate Ratings) -->
  <CustomerTestimonials />

  <!-- 7. LOCAL FAQ -->
  <section class="section">
    <div class="container">
      <div class="section-title-wrap">
        <div class="badge-pill">
          <span>Questions Fréquentes</span>
        </div>
        <h2>Vos Questions sur nos Dépannages à Tournai</h2>
        <p>Toutes les réponses pour comprendre nos interventions et anticiper les démarches.</p>
      </div>

      <div class="faq-list">
        <div class="card faq-item">
          <h3 class="faq-question">Quel est le délai réel d'intervention pour une urgence à Tournai ?</h3>
          <p class="faq-answer">
            Grâce à nos camionnettes atelier basées au coeur de Tournai, nous intervenons dans un délai moyen de 25 à 35 minutes à Tournai centre, Kain, Froyennes, Templeuve et Gaurain-Ramecroix.
          </p>
        </div>

        <div class="card faq-item">
          <h3 class="faq-question">La recherche de fuite est-elle remboursée par mon assurance habitation ?</h3>
          <p class="faq-answer">
            Oui. En Belgique, la plupart des polices d'assurance multirisque habitation (AXA, Ethias, AG Insurance, Belfius, Baloise) prennent en charge les frais de détection de fuite non destructive. Nous vous délivrons une facture détaillée et un rapport technique avec photos thermiques pour déclencher le remboursement intégral.
          </p>
        </div>

        <div class="card faq-item">
          <h3 class="faq-question">Comment savoir si mon eau est trop calcaire à Tournai ?</h3>
          <p class="faq-answer">
            L'eau distribuée par la SWDE dans le Tournaisis présente une dureté moyenne de 38 degrés français (°fH), classée comme très calcaire. Si vous observez des dépôts blanchâtres sur vos mousseurs de robinet, si votre groupe de sécurité de boiler goutte ou si vos appareils s'entartrent vite, la pose d'un adoucisseur permet de prolonger leur durée de vie de plus de 10 ans.
          </p>
        </div>

        <div class="card faq-item">
          <h3 class="faq-question">Comment se déroule la facturation ? Y a-t-il des frais cachés ?</h3>
          <p class="faq-answer">
            Aucune mauvaise surprise : dès son arrivée sur place, le technicien effectue un diagnostic initial et vous présente un devis écrit et chiffré. Les travaux ne commencent qu'après votre validation formelle.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. FINAL HIGH-CONVERSION CTA BANNER -->
  <section class="final-cta-section">
    <div class="container final-cta-inner">
      <div class="final-cta-content">
        <h2>Besoin d'un Dépannage Plomberie Immédiat ?</h2>
        <p>Notre technicien d'astreinte est prêt à intervenir chez vous à Tournai et dans sa périphérie.</p>
        <div class="final-cta-actions">
          <a href="tel:+3269456070" class="btn-primary final-btn-call">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>Appel d'Urgence : 069 45 60 70</span>
          </a>
          <a href="/contact" class="btn-secondary final-btn-devis">
            <span>Demande de devis en ligne</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero Styles */
  .hero-section {
    padding-top: 48px;
    padding-bottom: 64px;
    background: linear-gradient(180deg, #f8f9ff 0%, #eff4ff 100%);
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .hero-section {
      padding-top: 64px;
      padding-bottom: 96px;
    }
  }

  .hero-inner {
