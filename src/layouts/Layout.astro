---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCallBar from '../components/MobileCallBar.astro';
import TrustAuthoritySection from '../components/TrustAuthoritySection.astro';
import ContactFormSection from '../components/ContactFormSection.astro';
import GoogleMapSection from '../components/GoogleMapSection.astro';
import StickyCallButton from '../components/StickyCallButton.astro';
import LiveChatWhatsApp from '../components/LiveChatWhatsApp.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  currentPage?: string;
  schemaType?: string;
  preloadImage?: string;
}

const {
  title,
  description,
  canonicalPath = '',
  currentPage = 'home',
  schemaType = 'Plumber',
  preloadImage
} = Astro.props;

const siteUrl = 'https://www.plombiertournai.be';
const rawCanonical = canonicalPath || '';
const cleanCanonicalPath = rawCanonical === '/' ? '' : (rawCanonical.startsWith('/') ? rawCanonical : `/${rawCanonical}`);
const fullCanonical = `${siteUrl}${cleanCanonicalPath}`;

// Structured Data JSON-LD
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Plumber", "EmergencyService", "HomeAndConstructionBusiness"],
      "@id": `${siteUrl}/#organization`,
      "name": "Plombier Tournai",
      "legalName": "Plombier Tournai - Artisan Agréé",
      "url": siteUrl,
      "logo": `${siteUrl}/logo.png`,
      "image": `${siteUrl}/images/hero-real-sink.webp`,
      "description": "Artisan plombier agréé à Tournai et dans le Hainaut occidental. Dépannage plomberie d'urgence 24h/24 en 30 min, recherche de fuite d'eau non destructive, débouchage haute pression et installation sanitaire.",
      "telephone": "+32 464 78 05 73",
      "email": "contact@plombiertournai.be",
      "priceRange": "€€",
      "currenciesAccepted": "EUR",
      "paymentAccepted": "Cash, Carte Bancaire, Virement, Bancontact",
      "foundingDate": "2011",
      "hasMap": "https://maps.app.goo.gl/CFgP9LyR8tDeNwJe6",
      "sameAs": [
        "https://maps.app.goo.gl/CFgP9LyR8tDeNwJe6"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+32 464 78 05 73",
        "contactType": "emergency service",
        "areaServed": "BE",
        "availableLanguage": ["fr", "nl", "en"],
        "hoursAvailable": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
          "opens": "00:00",
          "closes": "23:59"
        }
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "127",
        "bestRating": "5",
        "worstRating": "1"
      },
      "award": [
        "Cerga Habilité Gaz Naturel",
        "Belgaqua Habilité Eau Potable",
        "VCA Certifié Sécurité Chantier",
        "Agréé Région Wallonne G1/G2",
        "Garantie Décennale 10 Ans",
        "Agréé Assurances Belges (Ethias, AXA, Belfius, AG, Baloise)"
      ],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Rue du Général Piron 234",
        "addressLocality": "Tournai",
        "postalCode": "7500",
        "addressRegion": "Hainaut",
        "addressCountry": "BE"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 50.592766,
        "longitude": 3.387224
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
          "opens": "00:00",
          "closes": "23:59"
        }
      ],
      "areaServed": [
        { "@type": "AdministrativeArea", "name": "Tournai 7500" },
        { "@type": "AdministrativeArea", "name": "Kain 7540" },
        { "@type": "AdministrativeArea", "name": "Froyennes 7503" },
        { "@type": "AdministrativeArea", "name": "Templeuve 7520" },
        { "@type": "AdministrativeArea", "name": "Blandain 7522" },
        { "@type": "AdministrativeArea", "name": "Gaurain-Ramecroix 7530" },
        { "@type": "AdministrativeArea", "name": "Orcq 7501" },
        { "@type": "AdministrativeArea", "name": "Rumillies 7540" },
        { "@type": "AdministrativeArea", "name": "Hertain 7522" },
        { "@type": "AdministrativeArea", "name": "Ramegnies-Chin 7520" }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Catalogue des Services de Plomberie et Dépannage Tournai",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Dépannage Plomberie d'Urgence 24/7",
              "description": "Intervention express en 30 minutes à Tournai pour fuite d'eau, canalisation rompue ou coupure d'eau d'urgence.",
              "serviceType": "Emergency Plumbing",
              "provider": { "@id": `${siteUrl}/#organization` }
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Recherche et Détection de Fuite Non Destructive",
              "description": "Localisation thermique, acoustique et gaz traceur sans démolition avec rapport officiel agréé assurances belges.",
              "serviceType": "Leak Detection",
              "provider": { "@id": `${siteUrl}/#organization` }
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Débouchage Haute Pression de Canalisations",
              "description": "Débouchage express et curage haute pression 180 bars d'éviers, WC, colonnes et réseau d'égouttage avec inspection caméra.",
              "serviceType": "Drain Cleaning",
              "provider": { "@id": `${siteUrl}/#organization` }
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Entretien, Réparation et Remplacement de Boiler & Chaudière",
              "description": "Dépannage de chauffe-eau électrique et chaudières gaz/mazout, détartrage et remplacement rapide par technicien agréé Cerga.",
              "serviceType": "Water Heater Repair",
              "provider": { "@id": `${siteUrl}/#organization` }
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Installation et Entretien d'Adoucisseur d'Eau Anti-Calcaire",
              "description": "Pose d'adoucisseurs d'eau adaptés à la dureté extrême SWDE de Tournai (38°fH) pour protéger canalisations et équipements.",
              "serviceType": "Water Softener Installation",
              "provider": { "@id": `${siteUrl}/#organization` }
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Installations Sanitaires & Rénovation Salle de Bain",
              "description": "Pose de sanitaires, WC suspendus Geberit, douches italiennes, tuyauterie cuivre/multicouche conforme aux normes Belgaqua.",
              "serviceType": "Sanitary Installation",
              "provider": { "@id": `${siteUrl}/#organization` }
            }
          }
        ]
      }
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "Plombier Tournai",
      "inLanguage": "fr-BE"
    }
  ]
};
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={fullCanonical} />
  
  <!-- Robots -->
  <meta name="robots" content="index, follow" />
  
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={fullCanonical} />
  <meta property="og:locale" content="fr_BE" />
  <meta property="og:site_name" content="Plombier Tournai" />
  
  <!-- Geo Tags for Local Belgian SEO -->
  <meta name="geo.region" content="BE-WHT" />
  <meta name="geo.placename" content="Tournai" />
  <meta name="geo.position" content="50.6056;3.3878" />
  <meta name="ICBM" content="50.6056, 3.3878" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <meta property="og:image" content={`${siteUrl}/logo.png`} />
  
  <!-- Preconnect to Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Image Preload for LCP Optimization -->
  {preloadImage && (
    <link rel="preload" as="image" href={preloadImage} type="image/webp" fetchpriority="high" />
  )}

  <!-- Critical CSS for Above-Fold Content & Core Web Vitals -->
  <style is:inline>
    :root {
      --color-surface: #f8f9ff;
      --color-surface-dim: #cbdbf5;
      --color-surface-container-lowest: #ffffff;
      --color-surface-container-low: #eff4ff;
      --color-surface-container: #e5eeff;
      --color-surface-container-highest: #d3e4fe;
      --color-on-surface: #0b1c30;
      --color-on-surface-variant: #434653;
      --color-outline: #737784;
      --color-border-hairline: #e0e8f2;
      --color-primary: #00327d;
      --color-primary-container: #0047ab;
      --color-on-primary: #ffffff;
      --color-secondary-container: #fcd400;
      --color-secondary-hover: #e9c400;
      --color-on-tertiary-fixed: #0b1b36;
      --font-heading: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --radius-xl: 24px;
      --shadow-sm: 0 1px 3px rgba(11, 28, 48, 0.05);
      --shadow-hover: 0 12px 24px -6px rgba(0, 71, 171, 0.1);
      --shadow-floating: 0 20px 32px -8px rgba(11, 27, 54, 0.15);
    }
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    html {
      font-family: var(--font-body);
      color: var(--color-on-surface);
      background-color: var(--color-surface);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      text-size-adjust: 100%;
    }
    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }
    .container {
      width: 100%;
      max-width: 1240px;
      margin-left: auto;
      margin-right: auto;
      padding-left: 20px;
      padding-right: 20px;
    }
    /* Top Bar Critical */
    .top-bar {
      background-color: var(--color-on-tertiary-fixed);
      color: #ffffff;
      font-size: 13px;
      padding: 8px 0;
      font-family: var(--font-body);
      min-height: 38px;
    }
    .top-bar-inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
    }
    @media (min-width: 768px) {
      .top-bar-inner { flex-direction: row; }
    }
    /* Main Header Critical */
    .main-header {
      position: sticky;
      top: 0;
      z-index: 100;
      background-color: rgba(255, 255, 255, 0.98);
      border-bottom: 1px solid var(--color-border-hairline);
      box-shadow: var(--shadow-sm);
    }
    .header-inner {
      height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }
    .brand-logo {
      display: flex;
      align-items: center;
      text-decoration: none;
      flex-shrink: 0;
    }
    .brand-logo-img {
      width: 44px;
      height: 44px;
      border-radius: var(--radius-md);
      object-fit: cover;
      box-shadow: 0 4px 10px rgba(0, 71, 171, 0.25);
    }
    /* Hero Critical */
    .hero-section {
      padding: 40px 0 60px;
      background: radial-gradient(circle at top right, rgba(220, 233, 255, 0.5) 0%, rgba(248, 249, 255, 1) 70%);
    }
    @media (min-width: 1024px) {
      .hero-section { padding: 60px 0 80px; }
      .hero-inner {
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: 50px;
        align-items: center;
      }
    }
    .hero-title {
      font-size: 32px;
      font-weight: 800;
      line-height: 1.2;
      color: var(--color-on-surface);
      margin-bottom: 20px;
      letter-spacing: -0.02em;
    }
    @media (min-width: 768px) {
      .hero-title { font-size: 44px; }
    }
    .hero-description {
      font-size: 17px;
      color: var(--color-on-surface-variant);
      line-height: 1.6;
      margin-bottom: 30px;
    }
    .hero-img {
      width: 100%;
      height: auto;
      aspect-ratio: 600 / 500;
      border-radius: var(--radius-xl);
      object-fit: cover;
      display: block;
    }
    .btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background-color: var(--color-secondary-container);
      color: var(--color-on-tertiary-fixed);
      font-weight: 700;
      padding: 14px 26px;
      border-radius: var(--radius-md);
      text-decoration: none;
      border: none;
      cursor: pointer;
      min-height: 48px;
    }
    /* Optimize off-screen rendering for Core Web Vitals */
    .below-fold {
      content-visibility: auto;
      contain-intrinsic-size: 1px 600px;
    }
  </style>

  <!-- Structured Data JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <Header currentPage={currentPage} />
  
  <main>
    <slot />
  </main>
  
  {currentPage !== 'contact' && <ContactFormSection />}
  
  <TrustAuthoritySection />
  
  <!-- Embedded Google Map -->
  <GoogleMapSection />
  
  <Footer />
  
  <!-- Sticky Click-to-Call Buttons (Desktop Pill & Mobile Sticky Bar) -->
  <StickyCallButton />
  <MobileCallBar />
  
  <!-- Live Chat Widget (WhatsApp) -->
  <LiveChatWhatsApp />
</body>
</html>
