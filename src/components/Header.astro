---
interface Props {
  currentPage?: string;
}

const { currentPage = 'home' } = Astro.props;
---

<!-- Top Reassurance Bar -->
<div class="top-bar">
  <div class="container top-bar-inner">
    <div class="top-bar-left">
      <span class="icon-indicator">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 6v6l4 2"></path>
        </svg>
      </span>
      <span>Arrivée en 30 min 24/7 - 15 ans d'expérience - Certifié Cerga, Belgaqua & VCA - Agréé Assurances</span>
    </div>
    <div class="top-bar-right">
      <span class="badge-status">
        <span class="pulse-dot"></span>
        Plombier de garde disponible 24h/24
      </span>
      <span class="divider">|</span>
      <a href="tel:0464780573" class="top-phone-link" aria-label="Appeler le 0464 78 05 73">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span>0464 78 05 73</span>
      </a>
    </div>
  </div>
</div>

<!-- Main Sticky Header -->
<header class="main-header">
  <div class="container header-inner">
    <!-- Brand Logo -->
    <a href="/" class="brand-logo" aria-label="Plombier Tournai - Accueil">
      <img
        src="/logo-icon.png"
        alt="Logo Plombier Tournai"
        width="46"
        height="46"
        class="brand-logo-img"
      />
      <div class="logo-text">
        <span class="logo-title">PLOMBIER TOURNAI</span>
        <span class="logo-subtitle">15 Ans d'Expérience &bull; Certifié Cerga, Belgaqua & Assurances</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="nav-menu" aria-label="Navigation principale">
      <a href="/" class:list={['nav-link', { active: currentPage === 'home' }]}>Accueil</a>
      <a href="/services" class:list={['nav-link', { active: currentPage === 'services' }]}>Nos Services</a>
      <a href="/locations" class:list={['nav-link', { active: currentPage === 'locations' }]}>Zones d'Intervention</a>
      <a href="/blog" class:list={['nav-link', { active: currentPage === 'blog' }]}>Blog & Guides</a>
      <a href="/about" class:list={['nav-link', { active: currentPage === 'about' }]}>A Propos</a>
      <a href="/contact" class:list={['nav-link', { active: currentPage === 'contact' }]}>Devis & Contact</a>
    </nav>

    <!-- Header CTA Button -->
    <div class="header-action">
      <a href="tel:0464780573" class="btn-primary header-call-btn" aria-label="Appeler le 0464 78 05 73">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span class="btn-text">Urgence : 0464 78 05 73</span>
      </a>
      
      <!-- Mobile Menu Toggle Button -->
      <button class="mobile-menu-toggle" id="mobileMenuBtn" aria-label="Ouvrir le menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div class="mobile-nav-drawer" id="mobileNavDrawer">
    <div class="container mobile-nav-content">
      <a href="/" class:list={['mobile-nav-link', { active: currentPage === 'home' }]}>Accueil</a>
      <a href="/services" class:list={['mobile-nav-link', { active: currentPage === 'services' }]}>Nos Services</a>
      <a href="/locations" class:list={['mobile-nav-link', { active: currentPage === 'locations' }]}>Zones d'Intervention</a>
      <a href="/blog" class:list={['mobile-nav-link', { active: currentPage === 'blog' }]}>Blog & Guides</a>
      <a href="/about" class:list={['mobile-nav-link', { active: currentPage === 'about' }]}>A Propos</a>
      <a href="/contact" class:list={['mobile-nav-link', { active: currentPage === 'contact' }]}>Devis & Contact</a>
      <div class="mobile-nav-call">
        <a href="tel:0464780573" class="btn-primary mobile-call-btn">
          Appeler le 0464 78 05 73
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobileMenuBtn');
  const drawer = document.getElementById('mobileNavDrawer');
  
  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      drawer.classList.toggle('open');
    });
  }
</script>

<style>
  .top-bar {
    background-color: var(--color-on-tertiary-fixed);
    color: var(--color-on-primary);
    font-size: 13px;
    padding: 8px 0;
    font-family: var(--font-body);
  }

  .top-bar-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }

  @media (min-width: 768px) {
    .top-bar-inner {
      flex-direction: row;
    }
  }

  .top-bar-left {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-surface-container-high);
  }

  .icon-indicator {
    display: flex;
    align-items: center;
    color: var(--color-secondary-container);
  }

  .top-bar-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .badge-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-surface-container-high);
    font-weight: 500;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #22c55e;
    box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.4);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(34, 197, 94, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
  }

  .divider {
    color: var(--color-outline);
    opacity: 0.5;
  }

  .top-phone-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-secondary-container);
    font-weight: 700;
    font-family: var(--font-heading);
    transition: opacity var(--transition-fast);
  }

  .top-phone-link:hover {
    opacity: 0.85;
  }

  /* Main Header */
  .main-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border-hairline);
    box-shadow: var(--shadow-sm);
  }

  .header-inner {
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-logo-img {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    object-fit: cover;
    box-shadow: 0 4px 10px rgba(0, 71, 171, 0.25);
    border: 1.5px solid rgba(0, 71, 171, 0.2);
  }

  .logo-text {
    display: flex;
    flex-direction: column;
  }

  .logo-title {
    font-family: var(--font-heading);
    font-size: 19px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-on-surface);
  }

  .logo-subtitle {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-outline);
    text-transform: uppercase;
  }

  /* Nav menu */
  .nav-menu {
    display: none;
    align-items: center;
    gap: 28px;
  }

  @media (min-width: 992px) {
    .nav-menu {
      display: flex;
    }
  }

  .nav-link {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-on-surface-variant);
    text-decoration: none;
    padding: 6px 0;
    position: relative;
    transition: color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-primary-container);
  }

  .nav-link.active {
    color: var(--color-primary-container);
    font-weight: 700;
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2.5px;
    background-color: var(--color-primary-container);
    border-radius: 2px;
  }

  .header-action {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .header-call-btn {
    padding: 11px 20px;
    font-size: 15px;
  }

  .mobile-menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-hairline);
    background: transparent;
    color: var(--color-on-surface);
    cursor: pointer;
  }

  @media (min-width: 992px) {
    .mobile-menu-toggle {
      display: none;
    }
  }

  /* Drawer */
  .mobile-nav-drawer {
    display: none;
    border-top: 1px solid var(--color-border-hairline);
    background-color: #ffffff;
    padding: 16px 0 24px;
    box-shadow: var(--shadow-hover);
  }

  .mobile-nav-drawer.open {
    display: block;
  }

  .mobile-nav-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .mobile-nav-link {
    padding: 10px 0;
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 600;
    color: var(--color-on-surface);
    border-bottom: 1px solid var(--color-border-hairline);
  }

  .mobile-nav-link.active {
    color: var(--color-primary-container);
    font-weight: 700;
  }

  .mobile-nav-call {
    padding-top: 8px;
  }

  .mobile-call-btn {
    width: 100%;
    text-align: center;
  }
</style>
