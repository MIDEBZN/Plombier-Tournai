---
// StickyCallButton.astro
// Desktop sticky click-to-call button (Mobile is handled by MobileCallBar)
---

<aside class="desktop-sticky-call" aria-label="Bouton d'appel rapide urgence">
  <a href="tel:0464780573" class="sticky-call-link" aria-label="Appeler le 0464 78 05 73">
    <div class="call-icon-wrap">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
      </svg>
      <span class="live-dot-pulse"></span>
    </div>
    <div class="call-text-wrap">
      <span class="call-label">Urgence 24h/24 &bull; 30 min</span>
      <span class="call-number">0464 78 05 73</span>
    </div>
  </a>
</aside>

<style>
  .desktop-sticky-call {
    position: fixed;
    bottom: 24px;
    left: 24px;
    z-index: 998;
    display: none;
    font-family: var(--font-body);
  }

  @media (min-width: 992px) {
    .desktop-sticky-call {
      display: block;
    }
  }

  .sticky-call-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: linear-gradient(135deg, var(--color-primary) 0%, #001f35 100%);
    color: #ffffff;
    padding: 10px 18px 10px 14px;
    border-radius: var(--radius-full);
    border: 2px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 10px 28px rgba(0, 43, 73, 0.35);
    text-decoration: none;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .sticky-call-link:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 14px 34px rgba(0, 43, 73, 0.45);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .call-icon-wrap {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background-color: var(--color-tertiary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
    box-shadow: 0 4px 12px rgba(177, 44, 0, 0.4);
  }

  .call-icon-wrap svg {
    color: #ffffff;
  }

  .live-dot-pulse {
    position: absolute;
    top: -2px;
    right: -2px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: #22c55e;
    border: 2px solid var(--color-primary);
    animation: livePulse 2s infinite;
  }

  @keyframes livePulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7); }
    70% { transform: scale(1.05); box-shadow: 0 0 0 6px rgba(34, 197, 94, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
  }

  .call-text-wrap {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .call-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: rgba(255, 255, 255, 0.85);
  }

  .call-number {
    font-size: 17px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.5px;
  }
</style>
