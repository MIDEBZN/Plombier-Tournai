---
// ResponseTimeStats.astro
// Performance metrics and response time statistics
// Strict rule: Zero emojis, zero em dashes. Pure SVG vector icons.
---

<section class="response-stats-section" aria-label="Statistiques de réactivité et performance">
  <div class="container">
    <div class="stats-box">
      <!-- Live Status Bar -->
      <div class="stats-live-bar">
        <div class="live-indicator">
          <span class="pulsing-ping"></span>
          <span class="pulsing-dot"></span>
          <span class="live-text">Astreinte en direct : Équipes d'urgence déployées sur Tournai</span>
        </div>
        <div class="live-dispatch-tag">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span>Délai d'arrivée estimé : 20 à 30 min</span>
        </div>
      </div>

      <!-- Main Heading -->
      <div class="stats-header">
        <div class="badge-pill">
          <span class="badge-dot-gold"></span>
          <span>Chiffres Clés & Réactivité</span>
        </div>
        <h2 class="stats-heading">Une Réactivité Record au Service des Tournaisiens</h2>
        <p class="stats-sub">
          Des indicateurs d'intervention réels et mesurés sur plus de 15 années de service dans le Hainaut occidental.
        </p>
      </div>

      <!-- Stats Grid -->
      <div class="stats-grid">
        <!-- Stat 1: 30 minutes -->
        <div class="stat-card highlight-stat">
          <div class="stat-card-top">
            <div class="stat-icon-wrap gold-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <span class="stat-tag">Urgence 24/7</span>
          </div>
          <div class="stat-value-wrap">
            <span class="stat-number">30</span>
            <span class="stat-unit">min</span>
          </div>
          <h3 class="stat-label">Délai d'intervention garanti</h3>
          <p class="stat-desc">
            Temps moyen d'arrivée sur place pour les fuites majeures, canalisations bouchées et pannes d'eau chaude.
          </p>
          <div class="stat-foot">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Sur Tournai et 29 entités</span>
          </div>
        </div>

        <!-- Stat 2: 98.4% First-time fix -->
        <div class="stat-card">
          <div class="stat-card-top">
            <div class="stat-icon-wrap blue-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
            </div>
            <span class="stat-tag blue-tag">Efficacité</span>
          </div>
          <div class="stat-value-wrap">
            <span class="stat-number">98.4</span>
            <span class="stat-unit">%</span>
          </div>
          <h3 class="stat-label">Pannes résolues au 1er passage</h3>
          <p class="stat-desc">
            Nos camionnettes-ateliers transportent plus de 450 pièces de rechange courantes (joints, vannes, raccords, cartouches).
          </p>
          <div class="stat-foot">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Sans aller-retour inutile</span>
          </div>
        </div>

        <!-- Stat 3: 4 850+ interventions -->
        <div class="stat-card">
          <div class="stat-card-top">
            <div class="stat-icon-wrap blue-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
            <span class="stat-tag blue-tag">Expérience</span>
          </div>
          <div class="stat-value-wrap">
            <span class="stat-number">4 850</span>
            <span class="stat-unit">+</span>
          </div>
          <h3 class="stat-label">Interventions réalisées</h3>
          <p class="stat-desc">
            Dépannages d'urgence, rénovations sanitaires et recherches de fuites exécutés depuis notre atelier de Tournai.
          </p>
          <div class="stat-foot">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Clients satisfaits et fidèles</span>
          </div>
        </div>

        <!-- Stat 4: 15 Ans -->
        <div class="stat-card">
          <div class="stat-card-top">
            <div class="stat-icon-wrap blue-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
            </div>
            <span class="stat-tag blue-tag">Pérennité</span>
          </div>
          <div class="stat-value-wrap">
            <span class="stat-number">15</span>
            <span class="stat-unit">ans</span>
          </div>
          <h3 class="stat-label">D'activité continue</h3>
          <p class="stat-desc">
            Entreprise artisanale locale fondée en 2011, titulaire de l'ensemble des certifications officielles belges.
          </p>
          <div class="stat-foot">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Artisan de proximité établi</span>
          </div>
        </div>
      </div>

      <!-- Quick Call Strip Inside Stats -->
      <div class="stats-cta-strip">
        <div class="cta-strip-text">
          <strong>Vous subissez une urgence plomberie en ce moment ?</strong>
          <span>Nos techniciens sont équipés et prêts à intervenir dans les 30 minutes.</span>
        </div>
        <div class="cta-strip-actions">
          <a href="tel:+3269456070" class="btn-primary stats-call-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>Appel direct : 069 45 60 70</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .response-stats-section {
    padding: 48px 0;
    background-color: var(--color-surface);
  }

  .stats-box {
    background: #ffffff;
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--radius-xl);
    padding: 32px 24px;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  @media (min-width: 768px) {
    .stats-box {
      padding: 44px 36px;
    }
  }

  /* Live Bar */
  .stats-live-bar {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 12px 18px;
    border-radius: 12px;
    background: #0b1b36;
    color: #ffffff;
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .stats-live-bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .live-indicator {
    display: flex;
    align-items: center;
    gap: 10px;
    position: relative;
  }

  .pulsing-ping {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: #22c55e;
    position: absolute;
    left: 0;
    animation: ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  .pulsing-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: #22c55e;
    position: relative;
    z-index: 1;
  }

  @keyframes ping {
    75%, 100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }

  .live-text {
    font-size: 14px;
    font-weight: 600;
    color: #ffffff;
  }

  .live-dispatch-tag {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-secondary-container);
    background: rgba(252, 212, 0, 0.12);
    padding: 4px 10px;
    border-radius: var(--radius-full);
  }

  /* Header */
  .stats-header {
    text-align: center;
    max-width: 740px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    background-color: var(--color-surface-container-low);
    border: 1px solid var(--color-outline-variant);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-primary);
  }

  .badge-dot-gold {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-secondary-container);
  }

  .stats-heading {
    font-size: 28px;
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-on-surface);
  }

  @media (min-width: 768px) {
    .stats-heading {
      font-size: 36px;
    }
  }

  .stats-sub {
    font-size: 16px;
    color: var(--color-on-surface-variant);
    line-height: 1.55;
  }

  /* Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 640px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .stats-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat-card {
    background: #ffffff;
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--radius-lg);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
  }

  .stat-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: #cbd9eb;
  }

  .highlight-stat {
    background: linear-gradient(180deg, #fffdf2 0%, #ffffff 100%);
    border-color: #f7df72;
    box-shadow: 0 4px 14px rgba(252, 212, 0, 0.12);
  }

  .stat-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .stat-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gold-icon {
    background: #fff8d6;
    color: #8c7300;
  }

  .blue-icon {
    background: var(--color-surface-container-low);
    color: var(--color-primary-container);
  }

  .stat-tag {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 3px 8px;
    border-radius: var(--radius-full);
    background: #fef08a;
    color: #713f12;
  }

  .blue-tag {
    background: #e0eaff;
    color: #1e40af;
  }

  .stat-value-wrap {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-top: 4px;
  }

  .stat-number {
    font-size: 42px;
    font-weight: 800;
    font-family: var(--font-heading);
    color: var(--color-on-surface);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .stat-unit {
    font-size: 22px;
    font-weight: 700;
    color: var(--color-primary-container);
  }

  .highlight-stat .stat-unit {
    color: #8c7300;
  }

  .stat-label {
    font-size: 17px;
    font-weight: 700;
    color: var(--color-on-surface);
    margin: 0;
  }

  .stat-desc {
    font-size: 13px;
    color: var(--color-on-surface-variant);
    line-height: 1.5;
    margin: 0;
  }

  .stat-foot {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px dashed var(--color-border-hairline);
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-success);
  }

  /* CTA Strip */
  .stats-cta-strip {
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: var(--color-surface-container-low);
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--radius-lg);
    padding: 20px 24px;
    align-items: center;
  }

  @media (min-width: 768px) {
    .stats-cta-strip {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .cta-strip-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cta-strip-text strong {
    font-size: 16px;
    color: var(--color-on-surface);
  }

  .cta-strip-text span {
    font-size: 14px;
    color: var(--color-on-surface-variant);
  }

  .stats-call-btn {
    padding: 12px 24px;
    font-size: 15px;
    white-space: nowrap;
  }
</style>
