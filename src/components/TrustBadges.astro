---
// TrustBadges.astro
// Official Belgian regulatory certifications and trust badges
// Cerga, Belgaqua, VCA, G1/G2, Garantie Décennale 10 Ans, Partenaire Assurances
// Strict rule: Zero emojis, zero em dashes. Pure SVG vector icons.
---

<section class="trust-badges-section" aria-label="Labels de conformité et certifications officielles">
  <div class="container">
    <div class="trust-badges-wrapper">
      <div class="trust-badges-header">
        <div class="badge-pill">
          <span class="badge-dot-gold"></span>
          <span>Agréments Réglementaires</span>
        </div>
        <h2 class="trust-badges-heading">Nos Labels de Confiance et Certifications Belges</h2>
        <p class="trust-badges-sub">
          Chaque intervention est couverte par nos agréments officiels et conforme aux normes en vigueur en Région Wallonne.
        </p>
      </div>

      <div class="trust-badges-grid">
        <!-- Badge 1: Cerga Gaz -->
        <div class="trust-seal-card">
          <div class="seal-icon-box cerga-seal">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12 6.477 2 12 2z"></path>
              <path d="M8.5 14.5A2.5 2.5 0 0 0 11 17c2.5 0 2.5-3 5-3"></path>
              <circle cx="12" cy="8" r="2"></circle>
            </svg>
          </div>
          <div class="seal-content">
            <div class="seal-header">
              <span class="seal-code">Agrément BE-GAZ</span>
              <span class="seal-status">Actif</span>
            </div>
            <h3 class="seal-title">CERGA Habilité Gaz</h3>
            <p class="seal-desc">
              Installateur habilité gaz naturel en Belgique. Mise en conformité, attestation officielle Art. 24 et raccordement ORES.
            </p>
          </div>
          <div class="seal-footer">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Contrôle annuel certifié</span>
          </div>
        </div>

        <!-- Badge 2: Belgaqua Eau Potable -->
        <div class="trust-seal-card">
          <div class="seal-icon-box belgaqua-seal">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
              <path d="M12 9v4"></path>
              <path d="M12 17h.01"></path>
            </svg>
          </div>
          <div class="seal-content">
            <div class="seal-header">
              <span class="seal-code">Norme Belge SWDE</span>
              <span class="seal-status">Actif</span>
            </div>
            <h3 class="seal-title">BELGAQUA Agréé</h3>
            <p class="seal-desc">
              Protection sanitaire de l'eau potable. Pose de disconnecteurs, clapets anti-pollution et adoucisseurs d'eau conformes.
            </p>
          </div>
          <div class="seal-footer">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Conforme réseau SWDE</span>
          </div>
        </div>

        <!-- Badge 3: VCA Sécurité Chantiers -->
        <div class="trust-seal-card">
          <div class="seal-icon-box vca-seal">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="M9 12l2 2 4-4"></path>
            </svg>
          </div>
          <div class="seal-content">
            <div class="seal-header">
              <span class="seal-code">Certification Sécurité</span>
              <span class="seal-status">Actif</span>
            </div>
            <h3 class="seal-title">VCA Sécurité Chantier</h3>
            <p class="seal-desc">
              Norme stricte de prévention des accidents, gestion des risques chimiques et sécurité des personnes en intervention.
            </p>
          </div>
          <div class="seal-footer">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Personnel certifié VCA</span>
          </div>
        </div>

        <!-- Badge 4: Garantie Décennale 10 Ans -->
        <div class="trust-seal-card">
          <div class="seal-icon-box decennale-seal">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
          </div>
          <div class="seal-content">
            <div class="seal-header">
              <span class="seal-code">Couverture 10 Ans</span>
              <span class="seal-status">Actif</span>
            </div>
            <h3 class="seal-title">Garantie Décennale</h3>
            <p class="seal-desc">
              Responsabilité civile décennale couvrant les travaux lourds, rénovations sanitaires, tuyauteries encastrées et canalisations.
            </p>
          </div>
          <div class="seal-footer">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Protection contractuelle 10 ans</span>
          </div>
        </div>

        <!-- Badge 5: Habilitation G1/G2 Wallonie -->
        <div class="trust-seal-card">
          <div class="seal-icon-box wallonie-seal">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </div>
          <div class="seal-content">
            <div class="seal-header">
              <span class="seal-code">Région Wallonne</span>
              <span class="seal-status">Actif</span>
            </div>
            <h3 class="seal-title">Agréé G1 / G2 Wallonie</h3>
            <p class="seal-desc">
              Habilitation technique pour le contrôle périodique, la réception de chaudières gaz et la délivrance des attestations légales.
            </p>
          </div>
          <div class="seal-footer">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Attestations officielles valides</span>
          </div>
        </div>

        <!-- Badge 6: Agréé Compagnies d'Assurances -->
        <div class="trust-seal-card">
          <div class="seal-icon-box assurances-seal">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
          <div class="seal-content">
            <div class="seal-header">
              <span class="seal-code">Dossier Sinistre</span>
              <span class="seal-status">Actif</span>
            </div>
            <h3 class="seal-title">Partenaire Assurances</h3>
            <p class="seal-desc">
              Rapports techniques d'expertise photographique acceptés par Ethias, AXA, Belfius, AG Insurance, Baloise et P&V sous 24h.
            </p>
          </div>
          <div class="seal-footer">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Prise en charge à 100%</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .trust-badges-section {
    padding: 56px 0;
    background: #ffffff;
    border-top: 1px solid var(--color-border-hairline);
    border-bottom: 1px solid var(--color-border-hairline);
  }

  .trust-badges-wrapper {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .trust-badges-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    background-color: var(--color-surface-container-low);
    border: 1px solid var(--color-outline-variant);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-primary);
  }

  .badge-dot-gold {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-secondary-container);
  }

  .trust-badges-heading {
    font-size: 28px;
    font-weight: 800;
    line-height: 1.25;
    color: var(--color-on-surface);
  }

  @media (min-width: 768px) {
    .trust-badges-heading {
      font-size: 36px;
    }
  }

  .trust-badges-sub {
    font-size: 16px;
    color: var(--color-on-surface-variant);
    line-height: 1.55;
  }

  .trust-badges-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 640px) {
    .trust-badges-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .trust-badges-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }

  .trust-seal-card {
    background: #ffffff;
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--radius-lg);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
  }

  .trust-seal-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: #cbd9eb;
  }

  .seal-icon-box {
    width: 54px;
    height: 54px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cerga-seal {
    background-color: #fef3c7;
    color: #b45309;
    border: 1px solid #fde68a;
  }

  .belgaqua-seal {
    background-color: #e0f2fe;
    color: #0369a1;
    border: 1px solid #bae6fd;
  }

  .vca-seal {
    background-color: #dcfce7;
    color: #15803d;
    border: 1px solid #bbf7d0;
  }

  .decennale-seal {
    background-color: #ede9fe;
    color: #6d28d9;
    border: 1px solid #ddd6fe;
  }

  .wallonie-seal {
    background-color: #ffedd5;
    color: #c2410c;
    border: 1px solid #fed7aa;
  }

  .assurances-seal {
    background-color: #f1f5f9;
    color: #0047ab;
    border: 1px solid #cbd5e1;
  }

  .seal-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .seal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .seal-code {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-on-surface-variant);
  }

  .seal-status {
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    background-color: #dcfce7;
    color: #166534;
  }

  .seal-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--color-on-surface);
    margin: 0;
  }

  .seal-desc {
    font-size: 13.5px;
    color: var(--color-on-surface-variant);
    line-height: 1.5;
    margin: 0;
  }

  .seal-footer {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px dashed var(--color-border-hairline);
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-success);
  }
</style>
