---
// Sticky Mobile Emergency Call Bar
---

<aside class="mobile-sticky-bar" aria-label="Contact d'urgence mobile">
  <div class="mobile-bar-container">
    <div class="timer-badge">
      <span class="status-indicator"></span>
      <div class="timer-text">
        <span class="timer-label">Dépannage 24/7</span>
        <span class="timer-val">Arrivée 30 min</span>
      </div>
    </div>
    
    <div class="actions-group">
      <a href="https://wa.me/32464780573?text=Bonjour,%20j'ai%20une%20urgence%20plomberie%20%C3%A0%20Tournai" class="btn-whatsapp" aria-label="WhatsApp Plombier Tournai">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
        <span class="action-label">WhatsApp</span>
      </a>

      <a href="tel:0464780573" class="btn-call-emergency" aria-label="Appeler le plombier de garde au 0464 78 05 73">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span class="call-text">0464 78 05 73</span>
      </a>
    </div>
  </div>
</aside>

<style>
  .mobile-sticky-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 999;
    background-color: rgba(11, 27, 54, 0.98);
    backdrop-filter: blur(10px);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 -8px 24px rgba(11, 27, 54, 0.25);
    padding: 10px 14px calc(10px + env(safe-area-inset-bottom, 0px));
  }

  @media (min-width: 992px) {
    .mobile-sticky-bar {
      display: none;
    }
  }

  .mobile-bar-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    max-width: 500px;
    margin: 0 auto;
  }

  .timer-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #ffffff;
    font-size: 11px;
    background-color: rgba(255, 255, 255, 0.08);
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
  }

  .status-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #22c55e;
    box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.4);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 5px rgba(34, 197, 94, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
  }

  .timer-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .timer-label {
    color: var(--color-surface-dim);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .timer-val {
    font-weight: 700;
    color: #ffffff;
  }

  .actions-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-grow: 1;
    justify-content: flex-end;
  }

  .btn-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: #25d366;
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    padding: 10px 12px;
    border-radius: var(--radius-md);
    text-decoration: none;
    flex-shrink: 0;
  }

  .btn-call-emergency {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: var(--color-secondary-container);
    color: var(--color-on-tertiary-fixed);
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 800;
    padding: 10px 16px;
    border-radius: var(--radius-md);
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(252, 212, 0, 0.4);
    flex-grow: 1;
    white-space: nowrap;
  }

  .call-text {
    letter-spacing: -0.01em;
  }
</style>
