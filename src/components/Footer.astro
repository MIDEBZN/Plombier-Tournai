---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <!-- Trust Strip -->
  <div class="footer-trust-strip">
    <div class="container trust-strip-inner">
      <div class="trust-item">
        <div class="trust-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <div class="trust-text">
          <strong>Agréé Assurances Belges</strong>
          <span>Rapports 100% remboursés Ethias, AXA, Belfius, AG</span>
        </div>
      </div>
      <div class="trust-item">
        <div class="trust-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
        </div>
        <div class="trust-text">
          <strong>15 Ans d'Expérience</strong>
          <span>Artisan local depuis 2011 &bull; 4 800+ interventions</span>
        </div>
      </div>
      <div class="trust-item">
        <div class="trust-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
          </svg>
        </div>
        <div class="trust-text">
          <strong>Toutes Certifications</strong>
          <span>Cerga Gaz, Belgaqua, VCA & Habilitation G1/G2</span>
        </div>
      </div>
      <div class="trust-item">
        <div class="trust-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
        </div>
        <div class="trust-text">
          <strong>Garanties & Devis Fixe</strong>
          <span>Garantie décennale 10 ans & prix fixé avant travaux</span>
        </div>
      </div>
      <div class="trust-item">
        <div class="trust-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
          </svg>
        </div>
        <div class="trust-text">
          <strong>Arrivée en 30 Min Chrono</strong>
          <span>Astreinte d'urgence 24h/24 et 7j/7 Grand Tournai</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Footer Content -->
  <div class="container footer-main">
    <div class="footer-grid">
      <!-- Col 1: About & Info -->
      <div class="footer-col col-brand">
        <div class="footer-brand">
          <div class="brand-logo-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
            </svg>
          </div>
          <span class="brand-name">PLOMBIER TOURNAI</span>
        </div>
        <p class="brand-desc">
          Votre artisan plombier de référence à Tournai et dans le Hainaut occidental. Spécialiste du dépannage d'urgence 24h/24, de la recherche de fuite non destructive, du débouchage haute pression et des installations sanitaires.
        </p>
        <div class="contact-chips">
          <a href="tel:+3269456070" class="contact-chip">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            069 45 60 70
          </a>
          <span class="contact-chip">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            Rue Royale 42, 7500 Tournai
          </span>
        </div>
      </div>

      <!-- Col 2: Services -->
      <div class="footer-col">
        <h3 class="footer-heading">Prestations Techniques</h3>
        <ul class="footer-links">
          <li><a href="/services/depannage-urgence">Dépannage d'urgence 24/7</a></li>
          <li><a href="/services/debouchage">Débouchage & hydrocurage haute pression</a></li>
          <li><a href="/services/detection-de-fuites">Détection de fuites d'eau sans casse</a></li>
          <li><a href="/services/chauffage-chaudieres">Chauffage, chaudières & boilers</a></li>
          <li><a href="/services/installations-sanitaires">Installations sanitaires & WC suspendus</a></li>
          <li><a href="/services/traitement-de-leau">Traitement de l'eau & adoucisseurs SWDE</a></li>
        </ul>
      </div>

      <!-- Col 3: Locations -->
      <div class="footer-col">
        <h3 class="footer-heading">Grand Tournai & Entités</h3>
        <ul class="footer-links">
          <li><a href="/locations/kain">Plombier Kain (7540)</a></li>
          <li><a href="/locations/froyennes">Plombier Froyennes (7503)</a></li>
          <li><a href="/locations/templeuve">Plombier Templeuve (7520)</a></li>
          <li><a href="/locations/blandain">Plombier Blandain (7522)</a></li>
          <li><a href="/locations/gaurain-ramecroix">Plombier Gaurain-Ramecroix (7530)</a></li>
          <li><a href="/locations#orcq">Plombier Orcq, Rumillies & Ere</a></li>
        </ul>
      </div>

      <!-- Col 4: Links & Certifications -->
      <div class="footer-col">
        <h3 class="footer-heading">Garanties & Devis</h3>
        <ul class="footer-links">
          <li><a href="/contact">Demander un devis gratuit</a></li>
          <li><a href="/about">Nos certifications Cerga & VCA</a></li>
          <li><a href="/about#tarifs">Grille tarifaire et forfaits</a></li>
          <li><a href="/about#avis">Avis clients certifiés</a></li>
          <li><a href="/contact#faq">Foire aux questions (FAQ)</a></li>
        </ul>
        <div class="footer-badges">
          <span class="badge-tag">Cerga Habilité</span>
          <span class="badge-tag">Belgaqua</span>
          <span class="badge-tag">VCA Sécurité</span>
          <span class="badge-tag">15 Ans Métier</span>
          <span class="badge-tag">Agréé Assurances</span>
          <span class="badge-tag">Garantie 10 Ans</span>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright & Legal -->
    <div class="footer-bottom">
      <div class="copyright-text">
        &copy; {year} Plombier Tournai SRL &bull; Tous droits réservés &bull; N&deg; TVA : BE 0845.291.839
      </div>
      <div class="legal-links">
        <a href="/about">Mentions Légales</a>
        <span class="dot">&bull;</span>
        <a href="/about">Politique de Confidentialité</a>
        <span class="dot">&bull;</span>
        <a href="/contact">Plan du Site</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-on-tertiary-fixed);
    color: var(--color-inverse-on-surface);
    margin-top: auto;
    font-family: var(--font-body);
  }

  .footer-trust-strip {
    background-color: #071526;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 24px 0;
  }

  .trust-strip-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 640px) {
    .trust-strip-inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .trust-strip-inner {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .trust-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background-color: rgba(0, 71, 171, 0.4);
    color: var(--color-secondary-container);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .trust-text {
    display: flex;
    flex-direction: column;
    font-size: 13px;
  }

  .trust-text strong {
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 14px;
  }

  .trust-text span {
    color: var(--color-surface-dim);
  }

  /* Main footer */
  .footer-main {
    padding-top: 64px;
    padding-bottom: 32px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
      gap: 36px;
    }
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .brand-logo-icon {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    background: var(--color-primary-container);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .brand-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-surface-dim);
    margin-bottom: 20px;
  }

  .contact-chips {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .contact-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #ffffff;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .contact-chip:hover {
    color: var(--color-secondary-container);
  }

  .footer-heading {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 18px;
    position: relative;
    padding-bottom: 8px;
  }

  .footer-heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 28px;
    height: 2px;
    background-color: var(--color-secondary-container);
    border-radius: 1px;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links a {
    color: var(--color-surface-dim);
    font-size: 14px;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .footer-links a:hover {
    color: #ffffff;
    padding-left: 4px;
  }

  .footer-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .badge-tag {
    display: inline-block;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 600;
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-full);
    color: var(--color-surface-dim);
  }

  /* Bottom bar */
  .footer-bottom {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 13px;
    color: var(--color-surface-dim);
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
    }
  }

  .legal-links {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .legal-links a {
    color: var(--color-surface-dim);
    text-decoration: none;
  }

  .legal-links a:hover {
    color: #ffffff;
  }

  .dot {
    opacity: 0.4;
  }
</style>
