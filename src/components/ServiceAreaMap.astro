---
// ServiceAreaMap.astro
// Visual interactive service area map and commune selector for Grand Tournai & Hainaut occidental
// Strict rule: Zero emojis, zero em dashes. Pure SVG vector icons.
---

<section class="service-map-section" id="carte-intervention" aria-label="Carte du secteur d'intervention Grand Tournai">
  <div class="container">
    <div class="service-map-header">
      <div class="badge-pill">
        <span class="badge-dot-gold"></span>
        <span>Secteur d'Intervention Garanti</span>
      </div>
      <h2 class="service-map-heading">Carte de Couverture Locale : Grand Tournai & 29 Entités</h2>
      <p class="service-map-sub">
        Nos camionnettes d'astreinte patrouillent en continu sur l'ensemble de l'agglomération tournaisienne avec un délai d'intervention moyen de 20 à 30 minutes.
      </p>
    </div>

    <!-- Map & Details Container -->
    <div class="map-layout-grid">
      <!-- Left: Visual SVG Map Representation -->
      <div class="map-visual-card">
        <div class="map-visual-top">
          <div class="map-status-pill">
            <span class="pulse-green"></span>
            <span>Réseau d'urgence actif : Hainaut occidental</span>
          </div>
          <span class="map-scale-tag">Rayon 25 km - 0€ déplacement</span>
        </div>

        <!-- Custom Stylized SVG Regional Map -->
        <div class="svg-map-wrapper">
          <svg viewBox="0 0 680 500" class="regional-svg-map" aria-label="Carte schématique du Grand Tournai">
            <defs>
              <linearGradient id="mapBgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#eff6ff" />
                <stop offset="100%" stop-color="#e0eefe" />
              </linearGradient>
              <linearGradient id="hubGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#0047ab" />
                <stop offset="100%" stop-color="#002b66" />
              </linearGradient>
              <filter id="mapShadow" x="-10%" y="-10%" width="120%" height="120%">
                <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#00327d" flood-opacity="0.08" />
              </filter>
            </defs>

            <!-- Background Territory Outline -->
            <rect width="680" height="500" rx="16" fill="url(#mapBgGrad)" />

            <!-- River Escaut (Scheldt) flowing through Tournai -->
            <path d="M 60,480 Q 200,380 300,280 T 380,210 T 450,120 T 560,20" fill="none" stroke="#93c5fd" stroke-width="12" stroke-linecap="round" opacity="0.6" />
            <path d="M 60,480 Q 200,380 300,280 T 380,210 T 450,120 T 560,20" fill="none" stroke="#60a5fa" stroke-width="4" stroke-linecap="round" opacity="0.8" />
            <text x="510" y="55" fill="#3b82f6" font-size="11" font-weight="600" letter-spacing="1">L'ESCAUT</text>

            <!-- Road Arteries (E42 & E429) -->
            <!-- E42 / A16 (Mons - Tournai - Lille) -->
            <path d="M 40,240 Q 200,250 340,250 T 640,260" fill="none" stroke="#cbd5e1" stroke-width="4" stroke-dasharray="6,4" />
            <text x="70" y="232" fill="#64748b" font-size="10" font-weight="700">AUTOROUTE E42 (VERS LILLE)</text>
            <text x="500" y="278" fill="#64748b" font-size="10" font-weight="700">E42 (VERS MONS / CHARLEROI)</text>

            <!-- E429 (Bruxelles - Tournai) -->
            <path d="M 340,250 L 600,80" fill="none" stroke="#cbd5e1" stroke-width="4" stroke-dasharray="6,4" />
            <text x="440" y="160" fill="#64748b" font-size="10" font-weight="700">E429 (VERS HAL / BRUXELLES)</text>

            <!-- N50 (Courtrai - Tournai) -->
            <path d="M 340,250 L 260,40" fill="none" stroke="#e2e8f0" stroke-width="3" stroke-dasharray="4,4" />
            <text x="270" y="70" fill="#64748b" font-size="10" font-weight="700">N50 (COURTRAI)</text>

            <!-- Radial coverage rings around Tournai Centre -->
            <circle cx="340" cy="250" r="80" fill="none" stroke="#0047ab" stroke-width="1.5" stroke-dasharray="5,5" opacity="0.3" />
            <circle cx="340" cy="250" r="160" fill="none" stroke="#0047ab" stroke-width="1.5" stroke-dasharray="5,5" opacity="0.2" />
            <circle cx="340" cy="250" r="230" fill="none" stroke="#0047ab" stroke-width="1.5" stroke-dasharray="5,5" opacity="0.12" />

            <text x="345" y="176" fill="#0047ab" font-size="10" font-weight="600" opacity="0.7">Rayon 10 km (15-20 min)</text>
            <text x="345" y="96" fill="#0047ab" font-size="10" font-weight="600" opacity="0.7">Rayon 20 km (25-30 min)</text>

            <!-- Commune Nodes & Pins -->
            <!-- 1. Central Hub: Tournai 7500 -->
            <g class="map-node hub-node" filter="url(#mapShadow)">
              <circle cx="340" cy="250" r="28" fill="url(#hubGrad)" />
              <circle cx="340" cy="250" r="36" fill="none" stroke="#fcd400" stroke-width="3" opacity="0.8" />
              <!-- Icon Wrench / House -->
              <circle cx="340" cy="250" r="6" fill="#fcd400" />
              <text x="340" y="295" text-anchor="middle" fill="#0b1c30" font-size="14" font-weight="800" font-family="'Plus Jakarta Sans', sans-serif">TOURNAI CENTRE</text>
              <text x="340" y="310" text-anchor="middle" fill="#0047ab" font-size="11" font-weight="700">Atelier Principal (7500)</text>
            </g>

            <!-- 2. Kain 7540 -->
            <g class="map-node">
              <circle cx="380" cy="180" r="14" fill="#ffffff" stroke="#0047ab" stroke-width="3" />
              <circle cx="380" cy="180" r="5" fill="#fcd400" />
              <text x="402" y="184" fill="#0b1c30" font-size="12" font-weight="700">Kain (7540)</text>
              <text x="402" y="197" fill="#16a34a" font-size="10" font-weight="600">Arrivée 15 min</text>
            </g>

            <!-- 3. Froyennes 7503 -->
            <g class="map-node">
              <circle cx="250" cy="210" r="14" fill="#ffffff" stroke="#0047ab" stroke-width="3" />
              <circle cx="250" cy="210" r="5" fill="#fcd400" />
              <text x="175" y="214" fill="#0b1c30" font-size="12" font-weight="700">Froyennes (7503)</text>
              <text x="175" y="227" fill="#16a34a" font-size="10" font-weight="600">Arrivée 15 min</text>
            </g>

            <!-- 4. Templeuve 7520 -->
            <g class="map-node">
              <circle cx="160" cy="150" r="14" fill="#ffffff" stroke="#0047ab" stroke-width="3" />
              <circle cx="160" cy="150" r="5" fill="#fcd400" />
              <text x="85" y="154" fill="#0b1c30" font-size="12" font-weight="700">Templeuve (7520)</text>
              <text x="85" y="167" fill="#16a34a" font-size="10" font-weight="600">Arrivée 20 min</text>
            </g>

            <!-- 5. Blandain 7522 -->
            <g class="map-node">
              <circle cx="170" cy="270" r="14" fill="#ffffff" stroke="#0047ab" stroke-width="3" />
              <circle cx="170" cy="270" r="5" fill="#fcd400" />
              <text x="95" y="274" fill="#0b1c30" font-size="12" font-weight="700">Blandain (7522)</text>
              <text x="95" y="287" fill="#16a34a" font-size="10" font-weight="600">Arrivée 20 min</text>
            </g>

            <!-- 6. Gaurain-Ramecroix 7530 -->
            <g class="map-node">
              <circle cx="510" cy="270" r="14" fill="#ffffff" stroke="#0047ab" stroke-width="3" />
              <circle cx="510" cy="270" r="5" fill="#fcd400" />
              <text x="532" y="274" fill="#0b1c30" font-size="12" font-weight="700">Gaurain (7530)</text>
              <text x="532" y="287" fill="#16a34a" font-size="10" font-weight="600">Arrivée 20 min</text>
            </g>

            <!-- 7. Rumillies 7540 -->
            <g class="map-node">
              <circle cx="430" cy="230" r="10" fill="#ffffff" stroke="#0047ab" stroke-width="2.5" />
              <circle cx="430" cy="230" r="3.5" fill="#0047ab" />
              <text x="446" y="234" fill="#334155" font-size="11" font-weight="600">Rumillies</text>
            </g>

            <!-- 8. Orcq 7501 -->
            <g class="map-node">
              <circle cx="270" cy="275" r="10" fill="#ffffff" stroke="#0047ab" stroke-width="2.5" />
              <circle cx="270" cy="275" r="3.5" fill="#0047ab" />
              <text x="286" y="279" fill="#334155" font-size="11" font-weight="600">Orcq</text>
            </g>

            <!-- 9. Mont-Saint-Aubert 7542 -->
            <g class="map-node">
              <circle cx="390" cy="110" r="10" fill="#ffffff" stroke="#0047ab" stroke-width="2.5" />
              <circle cx="390" cy="110" r="3.5" fill="#0047ab" />
              <text x="406" y="114" fill="#334155" font-size="11" font-weight="600">Mt-St-Aubert</text>
            </g>

            <!-- 10. Ere & Saint-Maur -->
            <g class="map-node">
              <circle cx="330" cy="350" r="10" fill="#ffffff" stroke="#0047ab" stroke-width="2.5" />
              <circle cx="330" cy="350" r="3.5" fill="#0047ab" />
              <text x="346" y="354" fill="#334155" font-size="11" font-weight="600">Ere / St-Maur</text>
            </g>

            <!-- 11. Chercq & Vaulx -->
            <g class="map-node">
              <circle cx="420" cy="330" r="10" fill="#ffffff" stroke="#0047ab" stroke-width="2.5" />
              <circle cx="420" cy="330" r="3.5" fill="#0047ab" />
              <text x="436" y="334" fill="#334155" font-size="11" font-weight="600">Chercq & Vaulx</text>
            </g>

            <!-- 12. Ramegnies-Chin -->
            <g class="map-node">
              <circle cx="280" cy="130" r="10" fill="#ffffff" stroke="#0047ab" stroke-width="2.5" />
              <circle cx="280" cy="130" r="3.5" fill="#0047ab" />
              <text x="180" y="134" fill="#334155" font-size="11" font-weight="600">Ramegnies-Chin</text>
            </g>

            <!-- Legend Box -->
            <g transform="translate(24, 410)">
              <rect width="210" height="70" rx="8" fill="#ffffff" opacity="0.92" stroke="#cbd5e1" stroke-width="1" />
              <circle cx="16" cy="20" r="6" fill="#0047ab" />
              <text x="30" y="24" fill="#0b1c30" font-size="11" font-weight="600">Atelier central (Tournai)</text>
              <circle cx="16" cy="40" r="6" fill="#ffffff" stroke="#0047ab" stroke-width="2" />
              <text x="30" y="44" fill="#0b1c30" font-size="11" font-weight="600">Entités & communes (20-30 min)</text>
              <line x1="10" y1="58" x2="22" y2="58" stroke="#3b82f6" stroke-width="3" />
              <text x="30" y="62" fill="#0b1c30" font-size="11" font-weight="600">Escaut & axes autoroutiers</text>
            </g>
          </svg>
        </div>

        <div class="map-visual-footer">
          <div class="map-foot-stat">
            <strong>29</strong>
            <span>Entités couvertes</span>
          </div>
          <div class="map-foot-stat">
            <strong>69 000+</strong>
            <span>Habitants protégés</span>
          </div>
          <div class="map-foot-stat">
            <strong>0€</strong>
            <span>Frais de déplacement</span>
          </div>
          <div class="map-foot-stat">
            <strong>30 min</strong>
            <span>Délai d'arrivée garanti</span>
          </div>
        </div>
      </div>

      <!-- Right: Interactive Communes Selector & Dispatch Info -->
      <div class="map-info-card">
        <div class="map-info-header">
          <h3 class="info-title">Vérifiez le Délai d'Intervention pour Votre Commune</h3>
          <p class="info-sub">
            Cliquez sur votre commune pour connaître la camionnette d'astreinte affectée et l'heure estimée d'intervention.
          </p>
        </div>

        <!-- Communes Fast Selector Pills -->
        <div class="communes-selector-grid">
          <button type="button" class="commune-pill active" data-commune="tournai" data-zip="7500" data-eta="15 à 25 min" data-dist="0 km (Centre-ville)">
            <span class="pill-name">Tournai Centre</span>
            <span class="pill-zip">7500</span>
          </button>
          <button type="button" class="commune-pill" data-commune="kain" data-zip="7540" data-eta="15 à 20 min" data-dist="3.5 km">
            <span class="pill-name">Kain</span>
            <span class="pill-zip">7540</span>
          </button>
          <button type="button" class="commune-pill" data-commune="froyennes" data-zip="7503" data-eta="15 à 20 min" data-dist="4.2 km">
            <span class="pill-name">Froyennes</span>
            <span class="pill-zip">7503</span>
          </button>
          <button type="button" class="commune-pill" data-commune="templeuve" data-zip="7520" data-eta="20 à 25 min" data-dist="7.8 km">
            <span class="pill-name">Templeuve</span>
            <span class="pill-zip">7520</span>
          </button>
          <button type="button" class="commune-pill" data-commune="blandain" data-zip="7522" data-eta="20 à 25 min" data-dist="8.5 km">
            <span class="pill-name">Blandain</span>
            <span class="pill-zip">7522</span>
          </button>
          <button type="button" class="commune-pill" data-commune="gaurain" data-zip="7530" data-eta="20 à 25 min" data-dist="7.2 km">
            <span class="pill-name">Gaurain-Ramecroix</span>
            <span class="pill-zip">7530</span>
          </button>
          <button type="button" class="commune-pill" data-commune="rumillies" data-zip="7540" data-eta="15 à 20 min" data-dist="3.0 km">
            <span class="pill-name">Rumillies</span>
            <span class="pill-zip">7540</span>
          </button>
          <button type="button" class="commune-pill" data-commune="orcq" data-zip="7501" data-eta="15 à 20 min" data-dist="3.8 km">
            <span class="pill-name">Orcq</span>
            <span class="pill-zip">7501</span>
          </button>
          <button type="button" class="commune-pill" data-commune="ere" data-zip="7500" data-eta="20 à 25 min" data-dist="5.1 km">
            <span class="pill-name">Ere & St-Maur</span>
            <span class="pill-zip">7500</span>
          </button>
          <button type="button" class="commune-pill" data-commune="ramegnies" data-zip="7520" data-eta="20 à 25 min" data-dist="6.4 km">
            <span class="pill-name">Ramegnies-Chin</span>
            <span class="pill-zip">7520</span>
          </button>
          <button type="button" class="commune-pill" data-commune="chercq" data-zip="7521" data-eta="15 à 20 min" data-dist="4.0 km">
            <span class="pill-name">Chercq & Vaulx</span>
            <span class="pill-zip">7521</span>
          </button>
          <button type="button" class="commune-pill" data-commune="mstaubert" data-zip="7542" data-eta="20 à 25 min" data-dist="6.8 km">
            <span class="pill-name">Mont-Saint-Aubert</span>
            <span class="pill-zip">7542</span>
          </button>
        </div>

        <!-- Selected Commune Status Card -->
        <div class="commune-status-box" id="commune-status-display">
          <div class="status-box-top">
            <div>
              <span class="status-zone-label">Zone sélectionnée</span>
              <h4 class="status-zone-name" id="selected-name">Tournai Centre (7500)</h4>
            </div>
            <span class="status-badge-live">Intervention disponible</span>
          </div>

          <div class="status-metrics-row">
            <div class="metric-item">
              <span class="metric-sub">Délai estimé</span>
              <strong class="metric-val text-gold" id="selected-eta">15 à 25 min</strong>
            </div>
            <div class="metric-item">
              <span class="metric-sub">Distance atelier</span>
              <strong class="metric-val" id="selected-dist">0 km (Centre-ville)</strong>
            </div>
            <div class="metric-item">
              <span class="metric-sub">Frais déplacement</span>
              <strong class="metric-val text-success">0€ (Inclus)</strong>
            </div>
          </div>

          <div class="status-box-actions">
            <a href="tel:+3269456070" class="btn-primary map-call-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>Envoyer un plombier ici : 069 45 60 70</span>
            </a>
            <a href="/locations" class="map-link-all">
              <span>Voir la fiche détaillée de toutes les communes</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Simple client interaction to update active commune card
  document.addEventListener('DOMContentLoaded', () => {
    const pills = document.querySelectorAll('.commune-pill');
    const nameEl = document.getElementById('selected-name');
    const etaEl = document.getElementById('selected-eta');
    const distEl = document.getElementById('selected-dist');

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');

        const name = pill.querySelector('.pill-name')?.textContent || '';
        const zip = pill.getAttribute('data-zip') || '';
        const eta = pill.getAttribute('data-eta') || '';
        const dist = pill.getAttribute('data-dist') || '';

        if (nameEl) nameEl.textContent = `${name} (${zip})`;
        if (etaEl) etaEl.textContent = eta;
        if (distEl) distEl.textContent = dist;
      });
    });
  });
</script>

<style>
  .service-map-section {
    padding: 64px 0;
    background-color: #ffffff;
    border-top: 1px solid var(--color-border-hairline);
    border-bottom: 1px solid var(--color-border-hairline);
  }

  .service-map-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 40px auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    background-color: var(--color-surface-container-low);
    border: 1px solid var(--color-outline-variant);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-primary);
  }

  .badge-dot-gold {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-secondary-container);
  }

  .service-map-heading {
    font-size: 28px;
    font-weight: 800;
    line-height: 1.25;
    color: var(--color-on-surface);
  }

  @media (min-width: 768px) {
    .service-map-heading {
      font-size: 38px;
    }
  }

  .service-map-sub {
    font-size: 16px;
    color: var(--color-on-surface-variant);
    line-height: 1.55;
  }

  .map-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: stretch;
  }

  @media (min-width: 1024px) {
    .map-layout-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 36px;
    }
  }

  /* Left Visual Map Card */
  .map-visual-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--radius-xl);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    box-shadow: var(--shadow-card);
  }

  .map-visual-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
  }

  .map-status-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-on-surface);
  }

  .pulse-green {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background-color: #16a34a;
    box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.2);
  }

  .map-scale-tag {
    font-size: 12px;
    font-weight: 700;
    color: var(--color-primary-container);
    background: var(--color-surface-container-high);
    padding: 3px 10px;
    border-radius: var(--radius-full);
  }

  .svg-map-wrapper {
    width: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #eff6ff;
    border: 1px solid #d8e5f8;
  }

  .regional-svg-map {
    width: 100%;
    height: auto;
    display: block;
  }

  .map-node {
    cursor: default;
    transition: transform var(--transition-fast);
  }

  .map-node:hover {
    transform: scale(1.05);
  }

  .map-visual-footer {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    padding-top: 14px;
    border-top: 1px solid var(--color-border-hairline);
  }

  @media (min-width: 640px) {
    .map-visual-footer {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .map-foot-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: #ffffff;
    padding: 10px;
    border-radius: 10px;
    border: 1px solid var(--color-border-hairline);
  }

  .map-foot-stat strong {
    font-size: 20px;
    font-weight: 800;
    color: var(--color-on-surface);
    font-family: var(--font-heading);
  }

  .map-foot-stat span {
    font-size: 11px;
    color: var(--color-on-surface-variant);
    font-weight: 500;
  }

  /* Right Info & Selector Card */
  .map-info-card {
    background: #ffffff;
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--radius-xl);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    box-shadow: var(--shadow-card);
  }

  .info-title {
    font-size: 22px;
    font-weight: 700;
    color: var(--color-on-surface);
    margin: 0 0 6px 0;
  }

  .info-sub {
    font-size: 14px;
    color: var(--color-on-surface-variant);
    line-height: 1.5;
    margin: 0;
  }

  /* Commune pills grid */
  .communes-selector-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
